; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Plane Walker: Chronicles of Collapse"
config/description="MVP vertical slice for Plane Walker."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
CombatFeedback="*res://autoload/combat_feedback.gd"
SceneLoader="*res://autoload/scene_loader.gd"
FocusCoordinator="*res://scripts/ui/focus_coordinator.gd"

[internationalization]

locale/translations=PackedStringArray("res://data/localization/translations.en.translation", "res://data/localization/translations.zh_CN.translation", "res://assets/production/localization/content_management.en.translation", "res://assets/production/localization/content_management.zh_CN.translation", "res://assets/production/localization/community.en.translation", "res://assets/production/localization/community.zh_CN.translation", "res://assets/production/localization/replay_library.en.translation", "res://assets/production/localization/replay_library.zh_CN.translation", "res://assets/production/localization/authored_challenges.en.translation", "res://assets/production/localization/authored_challenges.zh_CN.translation", "res://assets/production/localization/cosmetics.en.translation", "res://assets/production/localization/cosmetics.zh_CN.translation", "res://scripts/modes/endless_localization.en.translation", "res://scripts/modes/endless_localization.zh_CN.translation", "res://assets/production/localization/platform.en.translation", "res://assets/production/localization/platform.zh_CN.translation", "res://scripts/modes/daily_rewards_localization.en.translation", "res://scripts/modes/daily_rewards_localization.zh_CN.translation", "res://assets/production/localization/boss_rush_carried.en.translation", "res://assets/production/localization/boss_rush_carried.zh_CN.translation", "res://assets/production/localization/challenge_rewards.en.translation", "res://assets/production/localization/challenge_rewards.zh_CN.translation")
locale/fallback="en"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/content_pack_source_export/plugin.cfg")

[editor]

import/use_multiple_threads=false

