{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/save-profile/1.0.0",
  "title": "Plane Walker Profile Save Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "magic",
    "schema_version",
    "document_kind",
    "profile_id",
    "save_domain",
    "sequence",
    "game_version",
    "created_at_utc",
    "saved_at_utc",
    "content_snapshot",
    "payload",
    "integrity"
  ],
  "properties": {
    "magic": { "const": "PWSAVE" },
    "schema_version": { "const": 1 },
    "document_kind": { "const": "profile" },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "save_domain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "sequence": { "type": "integer", "minimum": 0 },
    "game_version": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "saved_at_utc": { "type": "string", "format": "date-time" },
    "content_snapshot": { "$ref": "#/$defs/content_snapshot" },
    "payload": { "type": "object" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "content_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_version", "schema_version", "fingerprint_sha256"],
      "properties": {
        "pack_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "pack_version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 1 },
        "fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "content_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_sha256", "packs"],
      "properties": {
        "aggregate_sha256": { "$ref": "#/$defs/sha256" },
        "packs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/content_pack" }
        }
      }
    }
  }
}
