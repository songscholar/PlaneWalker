{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/save-settings/2.0.0",
  "title": "Plane Walker Global Settings Save Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["magic", "schema_version", "document_kind", "sequence", "game_version", "created_at_utc", "saved_at_utc", "payload", "integrity"],
  "properties": {
    "magic": { "const": "PWSAVE" },
    "schema_version": { "const": 2 },
    "document_kind": { "const": "settings" },
    "sequence": { "type": "integer", "minimum": 0 },
    "game_version": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "saved_at_utc": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "master_volume", "master_muted", "camera_shake_enabled", "hit_flash_enabled", "reduced_motion"],
      "properties": {
        "locale": { "type": "string", "enum": ["zh_CN", "en"] },
        "master_volume": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "master_muted": { "type": "boolean" },
        "music_volume": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "sfx_volume": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "dialogue_volume": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "camera_shake_enabled": { "type": "boolean" },
        "hit_flash_enabled": { "type": "boolean" },
        "reduced_motion": { "type": "boolean" },
        "text_scale": { "type": "number", "enum": [1.0, 1.25, 1.5] },
        "high_contrast_danger": { "type": "boolean" },
        "subtitles_enabled": { "type": "boolean" },
        "subtitle_scale": { "type": "number", "enum": [1.0, 1.25, 1.5] },
        "ranged_charge_mode": { "type": "string", "enum": ["hold", "toggle"] },
        "damage_received_multiplier": { "type": "number", "enum": [1.0, 0.8, 0.6] },
        "enemy_telegraph_scale": { "type": "number", "enum": [1.0, 1.25, 1.5] }
      }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
