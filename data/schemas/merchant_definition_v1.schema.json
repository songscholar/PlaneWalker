{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/merchant-definition/1.0.0",
  "title": "Plane Walker Merchant Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "id", "schema_version", "name_key", "description_key", "availability", "floor_min", "floor_max", "portrait_id", "pixel_proxy_id", "shop_room_template_ids", "inventory_rules", "services", "accepted_costs", "economy_profile_id", "intro_key", "farewell_key"],
  "properties": {
    "category": { "const": "merchant_definition" },
    "id": { "type": "string", "enum": ["merchant_wayfarer", "merchant_chronomancer", "merchant_forgekeeper", "merchant_void_broker", "merchant_echo_archivist"] },
    "schema_version": { "type": "integer", "const": 1 },
    "name_key": { "$ref": "#/$defs/localization_key" },
    "description_key": { "$ref": "#/$defs/localization_key" },
    "availability": { "const": ["LAUNCH", "EXPANSION"] },
    "floor_min": { "type": "integer", "minimum": 1, "maximum": 5 },
    "floor_max": { "type": "integer", "minimum": 1, "maximum": 5 },
    "portrait_id": { "$ref": "#/$defs/id" },
    "pixel_proxy_id": { "$ref": "#/$defs/id" },
    "shop_room_template_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["room_shop_wayfarer_tent", "room_shop_chrono_emporium"] } },
    "inventory_rules": { "$ref": "#/$defs/inventory_rules" },
    "services": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["purchase_reward", "heal", "cleanse_curse", "reroll", "weapon_upgrade", "health_trade", "route_reveal", "sell_reward"] } },
    "accepted_costs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["gold", "health", "time_shard", "forge_essence", "reward"] } },
    "economy_profile_id": { "const": "launch_economy_v1" },
    "intro_key": { "$ref": "#/$defs/localization_key" },
    "farewell_key": { "$ref": "#/$defs/localization_key" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "localization_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "id_list": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "inventory_rules": { "type": "object", "additionalProperties": false, "required": ["offer_count_min", "offer_count_max", "rarity_weights", "content_categories", "required_tags", "allow_duplicates"], "properties": {
      "offer_count_min": { "type": "integer", "minimum": 1, "maximum": 8 },
      "offer_count_max": { "type": "integer", "minimum": 1, "maximum": 8 },
      "rarity_weights": { "type": "object", "additionalProperties": false, "required": ["common", "uncommon", "rare", "legendary", "unique"], "properties": { "common": { "$ref": "#/$defs/weight" }, "uncommon": { "$ref": "#/$defs/weight" }, "rare": { "$ref": "#/$defs/weight" }, "legendary": { "$ref": "#/$defs/weight" }, "unique": { "$ref": "#/$defs/weight" } } },
      "content_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["item", "blessing", "curse"] } },
      "required_tags": { "$ref": "#/$defs/id_list" },
      "allow_duplicates": { "const": false }
    } },
    "weight": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
