{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/content-entry/2.0.0",
  "title": "Plane Walker Content Entry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "availability",
    "name_key",
    "description_key",
    "tags",
    "compatibility",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "weapon",
        "time_ability",
        "item",
        "blessing",
        "curse",
        "talent",
        "enemy",
        "encounter",
        "room",
        "event",
        "merchant",
        "boss",
        "narrative",
        "cosmetic",
        "challenge"
      ]
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["M1", "CURRENT", "NEXT", "LAUNCH", "EXPANSION"]
      }
    },
    "name_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "description_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_ids": {"$ref": "#/$defs/id_list"},
        "weapon_ids": {"$ref": "#/$defs/id_list"},
        "time_ability_ids": {"$ref": "#/$defs/id_list"},
        "archetype_ids": {"$ref": "#/$defs/id_list"},
        "modes": {"$ref": "#/$defs/id_list"}
      }
    },
    "effects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
      },
      "additionalProperties": {
        "type": ["number", "integer", "boolean", "string"]
      }
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "archetype": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "legendary", "unique"]
    },
    "icon_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "references": {
      "$ref": "#/$defs/id_list"
    }
  },
  "$defs": {
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    }
  }
}
