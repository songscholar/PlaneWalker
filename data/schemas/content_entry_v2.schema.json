{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/content-entry/2.0.0",
  "title": "Plane Walker Content Entry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "availability",
    "name_key",
    "description_key",
    "tags",
    "compatibility",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "weapon",
        "time_ability",
        "item",
        "blessing",
        "curse",
        "talent",
        "enemy",
        "encounter",
        "room",
        "event",
        "merchant",
        "boss",
        "narrative",
        "cosmetic",
        "challenge",
        "archetype_profile",
        "weapon_runtime_profile",
        "character_runtime_profile"
      ]
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["M1", "CURRENT", "NEXT", "LAUNCH", "EXPANSION"]
      }
    },
    "name_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "description_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_ids": {"$ref": "#/$defs/id_list"},
        "weapon_ids": {"$ref": "#/$defs/id_list"},
        "time_ability_ids": {"$ref": "#/$defs/id_list"},
        "archetype_ids": {"$ref": "#/$defs/id_list"},
        "modes": {"$ref": "#/$defs/id_list"}
      }
    },
    "effects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
      },
      "additionalProperties": {
        "type": ["number", "integer", "boolean", "string"]
      }
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "archetype": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "legendary", "unique"]
    },
    "icon_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "references": {
      "$ref": "#/$defs/id_list"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "archetype_id": {
      "type": "string",
      "enum": [
        "freeze_burst",
        "rewind_echo",
        "rift_trap",
        "accelerated_combo",
        "low_hp_void",
        "perfect_guard",
        "piercing_barrage",
        "echo_legion"
      ]
    },
    "mechanic_tags": {
      "allOf": [
        { "$ref": "#/$defs/id_list" },
        { "minItems": 4 }
      ]
    },
    "starter_min": {
      "type": "integer",
      "const": 3
    },
    "payoff_min": {
      "type": "integer",
      "const": 2
    },
    "risk_min": {
      "type": "integer",
      "const": 1
    },
    "boss_conversion_id": {
      "type": "string",
      "enum": [
        "boss_weakpoint_exposure",
        "boss_rewind_path_strike",
        "boss_projectile_window",
        "boss_combo_break",
        "boss_execute_warning",
        "boss_counter_window",
        "boss_weakpoint_ammo_refund",
        "boss_facing_lure"
      ]
    },
    "boss_response_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "weapon_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "runtime_kind": {
      "type": "string",
      "enum": [
        "sword", "bow", "gun", "staff", "gauntlets",
        "wanderer_m1_compat", "wanderer", "time_guardian", "void_walker",
        "primordial_knight", "time_lord"
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/id_list"
    },
    "resources": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "payloads": {
      "type": "array"
    },
    "cues": {
      "type": "array"
    },
    "time_interactions": {
      "type": "object"
    },
    "boss_interactions": {
      "type": "object"
    },
    "base_stats": {
      "type": "object"
    },
    "mobility": {
      "type": "object"
    },
    "resource": {
      "type": "object"
    },
    "passive": {
      "type": "object"
    },
    "character_skill": {
      "type": "object"
    },
    "weapon_mastery": {
      "type": "object"
    },
    "presentation": {
      "type": "object"
    },
    "talent_ids": {
      "$ref": "#/$defs/id_list"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {"const": "character_runtime_profile"}
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "profile_version": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"const": "archetype_profile"}
        },
        "required": ["category"]
      },
      "then": {
        "required": [
          "references",
          "profile_version",
          "archetype_id",
          "mechanic_tags",
          "starter_min",
          "payoff_min",
          "risk_min",
          "boss_conversion_id",
          "boss_response_key"
        ],
        "properties": {
          "availability": {"const": ["LAUNCH", "EXPANSION"]},
          "effects": {"maxProperties": 0},
          "profile_version": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"not": {"const": "archetype_profile"}}
        },
        "required": ["category"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["archetype_id"]},
            {"required": ["mechanic_tags"]},
            {"required": ["starter_min"]},
            {"required": ["payoff_min"]},
            {"required": ["risk_min"]},
            {"required": ["boss_conversion_id"]},
            {"required": ["boss_response_key"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"not": {"const": "character_runtime_profile"}}
        },
        "required": ["category"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["character_id"]},
            {"required": ["base_stats"]},
            {"required": ["mobility"]},
            {"required": ["resource"]},
            {"required": ["passive"]},
            {"required": ["character_skill"]},
            {"required": ["weapon_mastery"]},
            {"required": ["presentation"]},
            {"required": ["talent_ids"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    }
  }
}
