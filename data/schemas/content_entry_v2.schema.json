{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/content-entry/2.0.0",
  "title": "Plane Walker Content Entry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "availability",
    "name_key",
    "description_key",
    "tags",
    "compatibility",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "weapon",
        "time_ability",
        "item",
        "blessing",
        "curse",
        "talent",
        "enemy",
        "encounter",
        "room",
        "event",
        "merchant",
        "boss",
        "narrative",
        "cosmetic",
        "challenge",
        "archetype_profile",
        "weapon_runtime_profile",
        "character_runtime_profile"
      ]
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["M1", "CURRENT", "NEXT", "LAUNCH", "EXPANSION"]
      }
    },
    "name_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "description_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_ids": {"$ref": "#/$defs/id_list"},
        "weapon_ids": {"$ref": "#/$defs/id_list"},
        "time_ability_ids": {"$ref": "#/$defs/id_list"},
        "archetype_ids": {"$ref": "#/$defs/id_list"},
        "modes": {"$ref": "#/$defs/id_list"}
      }
    },
    "effects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
      },
      "additionalProperties": {
        "type": ["number", "integer", "boolean", "string"]
      }
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "archetype": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{0,63}$"
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "legendary", "unique"]
    },
    "icon_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "item_mode": {
      "type": "string",
      "enum": ["passive", "active"]
    },
    "active_handler_id": {
      "type": "string",
      "enum": [
        "absolute_zero",
        "paradox_beacon",
        "gravity_snare",
        "redline_injector",
        "blood_price",
        "aegis_reversal",
        "railshot",
        "army_of_yesterday"
      ]
    },
    "cooldown_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "active_parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": ["number", "integer", "boolean", "string"]
      }
    },
    "references": {
      "$ref": "#/$defs/id_list"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "archetype_id": {
      "type": "string",
      "enum": [
        "freeze_burst",
        "rewind_echo",
        "rift_trap",
        "accelerated_combo",
        "low_hp_void",
        "perfect_guard",
        "piercing_barrage",
        "echo_legion"
      ]
    },
    "mechanic_tags": {
      "allOf": [
        { "$ref": "#/$defs/id_list" },
        { "minItems": 4 }
      ]
    },
    "starter_min": {
      "type": "integer",
      "const": 3
    },
    "payoff_min": {
      "type": "integer",
      "const": 2
    },
    "risk_min": {
      "type": "integer",
      "const": 1
    },
    "boss_conversion_id": {
      "type": "string",
      "enum": [
        "boss_weakpoint_exposure",
        "boss_rewind_path_strike",
        "boss_projectile_window",
        "boss_combo_break",
        "boss_execute_warning",
        "boss_counter_window",
        "boss_weakpoint_ammo_refund",
        "boss_facing_lure"
      ]
    },
    "boss_response_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "weapon_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "runtime_kind": {
      "type": "string",
      "enum": [
        "sword", "bow", "gun", "staff", "gauntlets",
        "wanderer_m1_compat", "wanderer", "time_guardian", "void_walker",
        "primordial_knight", "time_lord"
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/id_list"
    },
    "resources": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "payloads": {
      "type": "array"
    },
    "cues": {
      "type": "array"
    },
    "time_interactions": {
      "type": "object"
    },
    "boss_interactions": {
      "type": "object"
    },
    "base_stats": {
      "type": "object"
    },
    "mobility": {
      "type": "object"
    },
    "resource": {
      "type": "object"
    },
    "passive": {
      "type": "object"
    },
    "character_skill": {
      "type": "object"
    },
    "weapon_mastery": {
      "type": "object"
    },
    "presentation": {
      "type": "object"
    },
    "talent_ids": {
      "$ref": "#/$defs/id_list"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {"const": "character_runtime_profile"}
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "profile_version": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"const": "archetype_profile"}
        },
        "required": ["category"]
      },
      "then": {
        "required": [
          "references",
          "profile_version",
          "archetype_id",
          "mechanic_tags",
          "starter_min",
          "payoff_min",
          "risk_min",
          "boss_conversion_id",
          "boss_response_key"
        ],
        "properties": {
          "availability": {"const": ["LAUNCH", "EXPANSION"]},
          "effects": {"maxProperties": 0},
          "profile_version": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"not": {"const": "archetype_profile"}}
        },
        "required": ["category"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["archetype_id"]},
            {"required": ["mechanic_tags"]},
            {"required": ["starter_min"]},
            {"required": ["payoff_min"]},
            {"required": ["risk_min"]},
            {"required": ["boss_conversion_id"]},
            {"required": ["boss_response_key"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"not": {"const": "character_runtime_profile"}}
        },
        "required": ["category"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["character_id"]},
            {"required": ["base_stats"]},
            {"required": ["mobility"]},
            {"required": ["resource"]},
            {"required": ["passive"]},
            {"required": ["character_skill"]},
            {"required": ["weapon_mastery"]},
            {"required": ["presentation"]},
            {"required": ["talent_ids"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {"not": {"const": "item"}}
        },
        "required": ["category"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["item_mode"]},
            {"required": ["active_handler_id"]},
            {"required": ["cooldown_frames"]},
            {"required": ["active_parameters"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "item_mode": {"const": "active"}
        },
        "required": ["item_mode"]
      },
      "then": {
        "required": ["active_handler_id", "cooldown_frames", "active_parameters"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["active_handler_id"]},
            {"required": ["cooldown_frames"]},
            {"required": ["active_parameters"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "absolute_zero"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/absolute_zero_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "paradox_beacon"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/paradox_beacon_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "gravity_snare"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/gravity_snare_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "redline_injector"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/redline_injector_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "blood_price"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/blood_price_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "aegis_reversal"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/aegis_reversal_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "railshot"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/railshot_active_parameters"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_handler_id": {"const": "army_of_yesterday"}
        },
        "required": ["active_handler_id"]
      },
      "then": {
        "properties": {
          "active_parameters": {
            "$ref": "#/$defs/army_of_yesterday_active_parameters"
          }
        }
      }
    }
  ],
  "$defs": {
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    },
    "absolute_zero_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius",
        "duration_frames",
        "weakpoint_bonus",
        "energy_cost"
      ],
      "properties": {
        "radius": {"type": "number", "minimum": 32, "maximum": 512},
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "weakpoint_bonus": {"type": "number", "minimum": 0, "maximum": 3},
        "energy_cost": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "paradox_beacon_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rewind_frames",
        "echo_damage_multiplier",
        "energy_cost"
      ],
      "properties": {
        "rewind_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "echo_damage_multiplier": {"type": "number", "minimum": 0, "maximum": 3},
        "energy_cost": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "gravity_snare_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius",
        "duration_frames",
        "slow_ratio",
        "energy_cost"
      ],
      "properties": {
        "radius": {"type": "number", "minimum": 32, "maximum": 512},
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "slow_ratio": {"type": "number", "minimum": 0, "maximum": 0.9},
        "energy_cost": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "redline_injector_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_frames",
        "speed_multiplier",
        "health_cost_ratio"
      ],
      "properties": {
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "speed_multiplier": {"type": "number", "minimum": 1, "maximum": 3},
        "health_cost_ratio": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "blood_price_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_frames",
        "damage_multiplier",
        "health_cost_ratio"
      ],
      "properties": {
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "damage_multiplier": {"type": "number", "minimum": 1, "maximum": 5},
        "health_cost_ratio": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "aegis_reversal_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_frames",
        "counter_multiplier",
        "energy_cost"
      ],
      "properties": {
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "counter_multiplier": {"type": "number", "minimum": 0, "maximum": 5},
        "energy_cost": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "railshot_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pierce_bonus",
        "damage_multiplier",
        "ammo_refund"
      ],
      "properties": {
        "pierce_bonus": {"type": "integer", "minimum": 1, "maximum": 20},
        "damage_multiplier": {"type": "number", "minimum": 1, "maximum": 5},
        "ammo_refund": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    },
    "army_of_yesterday_active_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "echo_count",
        "duration_frames",
        "echo_damage_multiplier",
        "energy_cost"
      ],
      "properties": {
        "echo_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 600},
        "echo_damage_multiplier": {"type": "number", "minimum": 0, "maximum": 2},
        "energy_cost": {"type": "number", "minimum": 0, "maximum": 100}
      }
    }
  }
}
