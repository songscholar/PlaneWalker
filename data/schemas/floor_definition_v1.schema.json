{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planewalker://schemas/floor-definition/1.0.0",
  "title": "Plane Walker Floor Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category", "id", "schema_version", "name_key", "description_key",
    "availability", "order", "route_room_min", "route_room_max",
    "graph_node_min", "graph_node_max", "allowed_room_types",
    "required_room_budgets", "environment_rule_id", "encounter_profile_id",
    "economy_profile_id", "merchant_ids", "event_ids", "palette_id",
    "music_cue_id", "boss_room_template_id", "boss_encounter_id"
  ],
  "properties": {
    "category": { "const": "floor_definition" },
    "id": { "$ref": "#/$defs/floor_id" },
    "schema_version": { "type": "integer", "const": 1 },
    "name_key": { "$ref": "#/$defs/localization_key" },
    "description_key": { "$ref": "#/$defs/localization_key" },
    "availability": { "const": ["LAUNCH", "EXPANSION"] },
    "order": { "type": "integer", "minimum": 1, "maximum": 5 },
    "route_room_min": { "type": "integer", "minimum": 6, "maximum": 9 },
    "route_room_max": { "type": "integer", "minimum": 6, "maximum": 9 },
    "graph_node_min": { "type": "integer", "minimum": 9, "maximum": 14 },
    "graph_node_max": { "type": "integer", "minimum": 9, "maximum": 14 },
    "allowed_room_types": {
      "type": "array", "minItems": 6, "uniqueItems": true,
      "items": { "$ref": "#/$defs/room_type" }
    },
    "required_room_budgets": { "$ref": "#/$defs/required_room_budgets" },
    "environment_rule_id": { "$ref": "#/$defs/environment_rule_id" },
    "encounter_profile_id": { "$ref": "#/$defs/encounter_profile_id" },
    "economy_profile_id": { "const": "launch_economy_v1" },
    "merchant_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/merchant_id" }
    },
    "event_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/event_id" }
    },
    "palette_id": { "$ref": "#/$defs/id" },
    "music_cue_id": { "$ref": "#/$defs/id" },
    "boss_room_template_id": { "$ref": "#/$defs/boss_room_id" },
    "boss_encounter_id": { "$ref": "#/$defs/boss_encounter_id" }
  },
  "allOf": [
    {
      "if": { "properties": { "id": { "const": "floor_ruins_of_remnant" } }, "required": ["id"] },
      "then": { "properties": {
        "order": { "const": 1 }, "route_room_min": { "const": 6 }, "route_room_max": { "const": 6 },
        "graph_node_min": { "const": 9 }, "graph_node_max": { "const": 9 },
        "allowed_room_types": { "const": ["combat", "elite", "treasure", "shop", "event", "boss", "rest"] },
        "required_room_budgets": { "const": { "shop_or_treasure_min": 1, "shop_min": 0, "treasure_min": 0, "event_min": 1, "rest_min": 1, "boss_count": 1 } },
        "environment_rule_id": { "const": "rule_crumbling_ground" },
        "encounter_profile_id": { "const": "encounter_profile_ruins_adapter_v1" },
        "palette_id": { "const": "palette_ruins_of_remnant" },
        "music_cue_id": { "const": "music_ruins_of_remnant" },
        "boss_room_template_id": { "const": "room_boss_ruin_king" },
        "boss_encounter_id": { "const": "boss_encounter_ruin_king_adapter_v1" }
      } }
    },
    {
      "if": { "properties": { "id": { "const": "floor_void_forest" } }, "required": ["id"] },
      "then": { "properties": {
        "order": { "const": 2 }, "route_room_min": { "const": 7 }, "route_room_max": { "const": 7 },
        "graph_node_min": { "const": 10 }, "graph_node_max": { "const": 10 },
        "allowed_room_types": { "const": ["combat", "elite", "treasure", "shop", "event", "boss", "rest"] },
        "required_room_budgets": { "const": { "shop_or_treasure_min": 1, "shop_min": 0, "treasure_min": 0, "event_min": 1, "rest_min": 1, "boss_count": 1 } },
        "environment_rule_id": { "const": "rule_void_spores" },
        "encounter_profile_id": { "const": "encounter_profile_forest_adapter_v1" },
        "palette_id": { "const": "palette_void_forest" },
        "music_cue_id": { "const": "music_void_forest" },
        "boss_room_template_id": { "const": "room_boss_forest_heart" },
        "boss_encounter_id": { "const": "boss_encounter_forest_heart_adapter_v1" }
      } }
    },
    {
      "if": { "properties": { "id": { "const": "floor_time_rift" } }, "required": ["id"] },
      "then": { "properties": {
        "order": { "const": 3 }, "route_room_min": { "const": 8 }, "route_room_max": { "const": 8 },
        "graph_node_min": { "const": 12 }, "graph_node_max": { "const": 12 },
        "allowed_room_types": { "const": ["combat", "elite", "treasure", "shop", "event", "boss", "rest"] },
        "required_room_budgets": { "const": { "shop_or_treasure_min": 1, "shop_min": 0, "treasure_min": 0, "event_min": 2, "rest_min": 1, "boss_count": 1 } },
        "environment_rule_id": { "const": "rule_temporal_distortion" },
        "encounter_profile_id": { "const": "encounter_profile_rift_adapter_v1" },
        "palette_id": { "const": "palette_time_rift" },
        "music_cue_id": { "const": "music_time_rift" },
        "boss_room_template_id": { "const": "room_boss_time_sovereign" },
        "boss_encounter_id": { "const": "boss_encounter_time_sovereign_adapter_v1" }
      } }
    },
    {
      "if": { "properties": { "id": { "const": "floor_plane_forge" } }, "required": ["id"] },
      "then": { "properties": {
        "order": { "const": 4 }, "route_room_min": { "const": 9 }, "route_room_max": { "const": 9 },
        "graph_node_min": { "const": 14 }, "graph_node_max": { "const": 14 },
        "allowed_room_types": { "const": ["combat", "elite", "treasure", "shop", "event", "boss", "rest"] },
        "required_room_budgets": { "const": { "shop_or_treasure_min": 0, "shop_min": 1, "treasure_min": 1, "event_min": 1, "rest_min": 1, "boss_count": 1 } },
        "environment_rule_id": { "const": "rule_forge_vents" },
        "encounter_profile_id": { "const": "encounter_profile_forge_adapter_v1" },
        "palette_id": { "const": "palette_plane_forge" },
        "music_cue_id": { "const": "music_plane_forge" },
        "boss_room_template_id": { "const": "room_boss_forge_colossus" },
        "boss_encounter_id": { "const": "boss_encounter_forge_colossus_adapter_v1" }
      } }
    },
    {
      "if": { "properties": { "id": { "const": "floor_throne_of_void" } }, "required": ["id"] },
      "then": { "properties": {
        "order": { "const": 5 }, "route_room_min": { "const": 7 }, "route_room_max": { "const": 7 },
        "graph_node_min": { "const": 9 }, "graph_node_max": { "const": 9 },
        "allowed_room_types": { "const": ["combat", "elite", "treasure", "shop", "event", "boss"] },
        "required_room_budgets": { "const": { "shop_or_treasure_min": 1, "shop_min": 0, "treasure_min": 0, "event_min": 1, "rest_min": 0, "boss_count": 1 } },
        "environment_rule_id": { "const": "rule_collapsing_plane" },
        "encounter_profile_id": { "const": "encounter_profile_throne_adapter_v1" },
        "palette_id": { "const": "palette_throne_of_void" },
        "music_cue_id": { "const": "music_throne_of_void" },
        "boss_room_template_id": { "const": "room_boss_void_throne" },
        "boss_encounter_id": { "const": "boss_encounter_void_throne_adapter_v1" }
      } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "localization_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "floor_id": { "type": "string", "enum": ["floor_ruins_of_remnant", "floor_void_forest", "floor_time_rift", "floor_plane_forge", "floor_throne_of_void"] },
    "room_type": { "type": "string", "enum": ["combat", "elite", "treasure", "shop", "event", "boss", "rest"] },
    "environment_rule_id": { "type": "string", "enum": ["rule_crumbling_ground", "rule_void_spores", "rule_temporal_distortion", "rule_forge_vents", "rule_collapsing_plane"] },
    "encounter_profile_id": { "type": "string", "enum": ["encounter_profile_ruins_adapter_v1", "encounter_profile_forest_adapter_v1", "encounter_profile_rift_adapter_v1", "encounter_profile_forge_adapter_v1", "encounter_profile_throne_adapter_v1"] },
    "boss_encounter_id": { "type": "string", "enum": ["boss_encounter_ruin_king_adapter_v1", "boss_encounter_forest_heart_adapter_v1", "boss_encounter_time_sovereign_adapter_v1", "boss_encounter_forge_colossus_adapter_v1", "boss_encounter_void_throne_adapter_v1"] },
    "boss_room_id": { "type": "string", "enum": ["room_boss_ruin_king", "room_boss_forest_heart", "room_boss_time_sovereign", "room_boss_forge_colossus", "room_boss_void_throne"] },
    "merchant_id": { "type": "string", "enum": ["merchant_wayfarer", "merchant_chronomancer", "merchant_forgekeeper", "merchant_void_broker", "merchant_echo_archivist"] },
    "event_id": { "type": "string", "enum": ["event_chronal_altar", "event_trapped_traveler", "event_cursed_pool", "event_smiths_legacy", "event_memory_mirror", "event_planar_merchant", "event_void_rift", "event_sleeping_guardian", "event_twisted_well", "event_soul_contract", "event_time_paradox", "event_sacrificial_altar", "event_lost_journal", "event_rift_garden", "event_final_choice", "event_void_whispers", "event_perfect_rewind", "event_old_reunion"] },
    "required_room_budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["shop_or_treasure_min", "shop_min", "treasure_min", "event_min", "rest_min", "boss_count"],
      "properties": {
        "shop_or_treasure_min": { "type": "integer", "minimum": 0, "maximum": 1 },
        "shop_min": { "type": "integer", "minimum": 0, "maximum": 1 },
        "treasure_min": { "type": "integer", "minimum": 0, "maximum": 1 },
        "event_min": { "type": "integer", "minimum": 1, "maximum": 2 },
        "rest_min": { "type": "integer", "minimum": 0, "maximum": 1 },
        "boss_count": { "type": "integer", "const": 1 }
      }
    }
  }
}
